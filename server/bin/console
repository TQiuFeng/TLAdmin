#!/usr/bin/env php
<?php

/**
 * TLAdmin CLI 入口。
 *
 * 用法:
 *   php bin/console migrate          执行未应用的迁移
 *   php bin/console migrate:status   查看迁移状态
 *   php bin/console seed             执行种子数据
 *   php bin/console route:list       输出注解路由表
 *   php bin/console route:cache      重建路由缓存
 *   php bin/console key:generate     生成 APP_KEY 写入 .env(已有值时需 --force)
 *   php bin/console secrets:reencrypt [--from=旧APP_KEY]  用当前 APP_KEY 重新加密存量密钥
 * Author: qiufeng
 */

declare(strict_types=1);

use app\common\config\EnvLoader;
use app\common\database\DbBootstrap;
use app\common\database\Migrator;
use app\common\router\RouteScanner;

$rootPath = dirname(__DIR__);
require $rootPath . '/vendor/autoload.php';

EnvLoader::load($rootPath . '/.env');
DbBootstrap::init();

// CLI 里的出站请求同样落第三方请求日志
\app\common\support\Tools::$httpAfterRequest = static function (array $result): void {
    (new \app\common\service\log\ThirdPartyLogService())->record($result);
};

$migrator = new Migrator($rootPath . '/database/migrations', $rootPath . '/database/seeders');
$command = $argv[1] ?? 'help';

try {
    switch ($command) {
        case 'migrate':
            $executed = $migrator->migrate();
            echo $executed === []
                ? "没有待执行的迁移\n"
                : "已执行迁移:\n  " . implode("\n  ", $executed) . "\n";
            break;

        case 'migrate:status':
            $status = $migrator->status();
            echo "已应用 (" . count($status['applied']) . "):\n";
            foreach ($status['applied'] as $name) {
                echo "  [x] {$name}\n";
            }
            echo "待执行 (" . count($status['pending']) . "):\n";
            foreach ($status['pending'] as $name) {
                echo "  [ ] {$name}\n";
            }
            break;

        case 'seed':
            $executed = $migrator->seed();
            echo $executed === []
                ? "没有可执行的种子\n"
                : "已执行种子:\n  " . implode("\n  ", $executed) . "\n";
            break;

        case 'route:list':
            $routes = RouteScanner::scan($rootPath . '/app/adminapi/controller', 'app\\adminapi\\controller');
            usort($routes, static fn (array $a, array $b): int => [$a[1], $a[0]] <=> [$b[1], $b[0]]);
            printf("%-7s %-55s %-32s %s\n", 'METHOD', 'PATH', 'PERMISSION', 'SUMMARY');
            foreach ($routes as [$method, $path, $handler, $meta]) {
                printf(
                    "%-7s %-55s %-32s %s\n",
                    $method,
                    $path,
                    ($meta['auth'] ?? true) === false ? '(公开)' : ($meta['permission'] ?? '(登录)'),
                    $meta['summary'] ?? ''
                );
            }
            echo "共 " . count($routes) . " 条路由\n";
            break;

        case 'route:cache':
            $cacheFile = $rootPath . '/runtime/cache/routes.php';
            if (is_file($cacheFile)) {
                unlink($cacheFile);
            }
            $routes = RouteScanner::scan($rootPath . '/app/adminapi/controller', 'app\\adminapi\\controller', $cacheFile);
            echo "路由缓存已重建,共 " . count($routes) . " 条路由\n";
            break;

        case 'schedule:list':
            $tasks = require $rootPath . '/config/schedule.php';
            printf("%-20s %-15s %-45s %s\n", 'NAME', 'CRON', 'HANDLER', 'DESCRIPTION');
            foreach ($tasks as $task) {
                printf("%-20s %-15s %-45s %s\n", $task['name'] ?? '', $task['cron'] ?? '', $task['handler'] ?? '', $task['description'] ?? '');
            }
            break;

        case 'schedule:run':
            $tasks = require $rootPath . '/config/schedule.php';
            $results = (new \app\common\schedule\Scheduler($tasks))->run();
            if ($results === []) {
                echo date('Y-m-d H:i') . " 没有到期任务\n";
                break;
            }
            foreach ($results as $name => $result) {
                echo date('Y-m-d H:i') . " {$name}: {$result}\n";
            }
            break;

        case 'queue:work':
            $once = in_array('--once', $argv, true);
            echo $once ? "消费一条任务…\n" : "队列消费中(Ctrl+C 退出)…\n";
            $handled = \app\common\queue\Queue::work($once);
            echo "本次处理 {$handled} 条\n";
            break;

        case 'queue:size':
            $size = \app\common\queue\Queue::size();
            echo "就绪: {$size['ready']} 条,延迟: {$size['delayed']} 条\n";
            break;

        case 'queue:push-demo':
            \app\common\queue\Queue::push(\app\job\DemoJob::class, ['message' => $argv[2] ?? 'hello', 'time' => date('H:i:s')]);
            echo "已入队 DemoJob\n";
            break;

        case 'gen:crud':
            $table = $argv[2] ?? '';
            if ($table === '') {
                echo "用法: php bin/console gen:crud <表名> [--title=标题] [--force]\n";
                exit(1);
            }
            $title = '';
            foreach ($argv as $arg) {
                if (str_starts_with($arg, '--title=')) {
                    $title = substr($arg, 8);
                }
            }
            $generator = new \app\common\generator\CrudGenerator($rootPath, dirname($rootPath) . '/web');
            $written = $generator->generate($table, $title, in_array('--force', $argv, true));
            echo "生成完成:\n  " . implode("\n  ", $written) . "\n";
            echo "下一步: php bin/console seed 写入菜单,重新登录即可看到新菜单\n";
            break;

        case 'key:generate':
            $envFile = $rootPath . '/.env';
            if (!is_file($envFile)) {
                echo "未找到 .env,请先复制 .env.example。新密钥:\n" . \app\common\support\AppKey::generate() . "\n";
                break;
            }
            if (!\app\common\support\AppKey::writeToEnvFile($envFile, in_array('--force', $argv, true))) {
                echo "APP_KEY 已有值,未覆盖。更换密钥会让已加密的数据解不开;确需更换请加 --force,\n"
                    . "之后执行 php bin/console secrets:reencrypt --from=旧密钥 把存量密文换成新密钥。\n";
                exit(1);
            }
            echo "已写入 .env 的 APP_KEY。如果之前存过第三方密钥或绑定过动态验证码,请执行 php bin/console secrets:reencrypt\n";
            break;

        case 'secrets:reencrypt':
            $previous = [];
            foreach ($argv as $arg) {
                if (str_starts_with($arg, '--from=')) {
                    $previous[] = substr($arg, 7);
                }
            }
            $config = new \app\common\config\ConfigRepository(
                [
                    $rootPath . '/config/app.php',
                    $rootPath . '/config/api.php',
                    $rootPath . '/config/integration.php',
                    $rootPath . '/config/security.php',
                ],
                $rootPath . '/runtime/config/system.json'
            );
            $result = (new \app\common\service\security\SecretReencryptService($config))->run($previous);
            echo "重新加密:第三方配置 {$result['config']} 项,动态验证码 {$result['totp']} 个\n";
            if ($result['failed'] !== []) {
                echo "解不开(需要用 --from 提供加密时的旧 APP_KEY):\n  " . implode("\n  ", $result['failed']) . "\n";
                exit(1);
            }
            break;

        default:
            echo "可用命令:\n"
                . "  migrate          执行未应用的迁移\n"
                . "  migrate:status   查看迁移状态\n"
                . "  seed             执行种子数据\n"
                . "  route:list       输出注解路由表\n"
                . "  route:cache      重建路由缓存\n"
                . "  schedule:list    查看定时任务表\n"
                . "  schedule:run     执行到期定时任务(配合系统 crontab 每分钟调用)\n"
                . "  queue:work       队列消费(--once 只消费一条)\n"
                . "  queue:size       查看队列长度\n"
                . "  queue:push-demo  入队一个示例任务(调试用)\n"
                . "  key:generate     生成 APP_KEY 写入 .env(已有值时需 --force)\n"
                . "  secrets:reencrypt [--from=旧APP_KEY]  用当前 APP_KEY 重新加密存量密钥\n";
    }
} catch (Throwable $e) {
    fwrite(STDERR, "执行失败: {$e->getMessage()}\n{$e->getTraceAsString()}\n");
    exit(1);
}
